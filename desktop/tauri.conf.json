{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Curis",
  "version": "0.1.0",
  "identifier": "com.curis.desktop",
  "build": {
    "beforeDevCommand": "cd ../frontend && pnpm dev --port 3010",
    "devUrl": "http://127.0.0.1:3010",
    "beforeBuildCommand": "./scripts/build-runtime.sh",
    "frontendDist": "../desktop/static"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Curis",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 18
        },
        "url": "http://127.0.0.1:3010",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "backup-restore-main",
          "windows": [
            "main"
          ],
          "webviews": [
            "main"
          ],
          "local": false,
          "remote": {
            "urls": [
              "http://127.0.0.1:3010"
            ]
          },
          "permissions": [
            "allow-create-curis-backup",
            "allow-preflight-curis-restore",
            "allow-commit-curis-restore",
            "allow-cancel-curis-restore",
            "allow-read-curis-recovery-status"
          ]
        },
        {
          "identifier": "writing-local-package-export",
          "windows": [
            "main"
          ],
          "webviews": [
            "main"
          ],
          "local": false,
          "remote": {
            "urls": [
              "http://127.0.0.1:3010"
            ]
          },
          "permissions": [
            "allow-save-writing-local-package"
          ]
        },
        {
          "identifier": "main-window",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-start-dragging"
          ],
          "remote": {
            "urls": [
              "http://127.0.0.1:3010",
              "http://127.0.0.1:8080"
            ]
          }
        },
        {
          "identifier": "cg-local-verification-export",
          "windows": [
            "main"
          ],
          "webviews": [
            "main"
          ],
          "local": false,
          "remote": {
            "urls": [
              "http://127.0.0.1:3010"
            ]
          },
          "permissions": [
            "allow-save-cg-local-verification"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Curis 一人 AI 公司经营空间",
    "longDescription": "Curis — CEO 的一人 AI 公司经营空间（Local Desktop）",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info-ATS.plist"
    },
    "resources": {
      ".runtime/runtime": "runtime"
    }
  },
  "plugins": {}
}
