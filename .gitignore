# WorkBuddy 运行产物（可重建，不入库）
.workbuddy/artifacts/
.workbuddy/tmp/

# Desktop packaging output (recreated by desktop/scripts/build-runtime.sh)
desktop/.runtime/

# Local build and cache output (keep Desktop source and evidence visible)
.next/
.cache/
frontend/.cache/
desktop/target/
desktop/node_modules/
desktop/runtime/__pycache__/

# SQLite journal files only; primary databases and backups remain visible for
# retention / evidence review and are intentionally not ignored here.
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm

