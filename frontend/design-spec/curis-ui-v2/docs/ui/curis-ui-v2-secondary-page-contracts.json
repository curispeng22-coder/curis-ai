{
  "version": "2.0.0",
  "scope": "secondary and detail surfaces not duplicated in curis-ui-v2-data-map.json",
  "commonStates": ["loading", "empty", "partial", "error"],
  "pages": {
    "analytics-org": {"primaryAction":"change-dimension", "fields":["dimension","metrics.projects","metrics.departments","metrics.workflows","breakdowns[]"]},
    "analytics-project": {"primaryAction":"open-project", "fields":["project.name","project.status","metrics.progress","metrics.tasks","metrics.runs","trend[]"]},
    "analytics-workflow": {"primaryAction":"open-workflow", "fields":["workflow.name","workflow.status","metrics.runs","metrics.successRate","trend[]"]},
    "brainstorm-active": {"primaryAction":"start-session", "fields":["sessions.active[].topic","sessions.active[].participants","sessions.active[].status","sessions.active[].updatedAt"]},
    "brainstorm-results": {"primaryAction":"open-result", "fields":["sessions.results[].topic","sessions.results[].conclusion","sessions.results[].decisions","sessions.results[].updatedAt"]},
    "brainstorm-session-detail": {"primaryAction":"add-conclusion", "fields":["session.topic","session.participants[]","session.status","session.timeline[]","session.conclusion"]},
    "capability-agent-list": {"primaryAction":"create-agent", "fields":["agents[].name","agents[].description","agents[].status","agents[].model","agents[].skills[]"]},
    "capability-model-list": {"primaryAction":"add-model", "fields":["models[].name","models[].provider","models[].status","models[].context","models[].cost"]},
    "capability-skill-list": {"primaryAction":"create-skill", "fields":["skills[].name","skills[].description","skills[].source","skills[].status","skills[].usage"]},
    "capability-tool-list": {"primaryAction":"add-tool", "fields":["tools[].name","tools[].kind","tools[].description","tools[].status","tools[].permissions"]},
    "capability-workflow-list": {"primaryAction":"create-workflow", "fields":["workflows[].name","workflows[].description","workflows[].status","workflows[].steps","workflows[].updatedAt"]},
    "department-detail": {"primaryAction":"create-employee", "fields":["department.name","department.description","department.owner","department.projects[]","department.employees[]","department.status"]},
    "employee-detail": {"primaryAction":"edit-employee", "fields":["employee.name","employee.role","employee.department","employee.projects[]","employee.model","employee.skills[]","employee.status"]},
    "execution-runs": {"primaryAction":"open-run", "fields":["runs[].name","runs[].project","runs[].workflow","runs[].status","runs[].startedAt","runs[].duration"]},
    "execution-tasks": {"primaryAction":"open-task", "fields":["tasks[].title","tasks[].project","tasks[].assignee","tasks[].status","tasks[].dueAt","tasks[].priority"]},
    "knowledge-company": {"primaryAction":"create-entry", "fields":["scope","entries[].title","entries[].type","entries[].owner","entries[].updatedAt","entries[].status"]},
    "knowledge-dept": {"primaryAction":"create-entry", "fields":["department","entries[].title","entries[].type","entries[].owner","entries[].updatedAt","entries[].status"]},
    "knowledge-entry-detail": {"primaryAction":"edit-entry", "fields":["entry.title","entry.type","entry.content","entry.owner","entry.source","entry.updatedAt","entry.status"]},
    "knowledge-project": {"primaryAction":"create-entry", "fields":["project","entries[].title","entries[].type","entries[].owner","entries[].updatedAt","entries[].status"]},
    "org-dept": {"primaryAction":"open-department", "fields":["department.name","department.owner","department.employeeCount","department.projects[]","department.status"]},
    "project-detail": {"primaryAction":"open-project-tab", "fields":["project.name","project.department","project.owner","project.status","project.progress","project.members[]","project.timeline[]"]},
    "report-detail": {"primaryAction":"acknowledge-report", "fields":["report.title","report.source","report.priority","report.status","report.summary","report.attachments[]","report.submittedAt"]},
    "run-detail": {"primaryAction":"retry-run", "fields":["run.name","run.project","run.workflow","run.status","run.startedAt","run.steps[]","run.error"]},
    "settings-brand": {"primaryAction":"save-brand", "fields":["brand.name","brand.logo","brand.primaryColor","brand.secondaryColor","brand.font"]},
    "settings-notify": {"primaryAction":"save-notifications", "fields":["notifications.channels[]","notifications.events[]","notifications.digest","notifications.quietHours"]},
    "settings-profile": {"primaryAction":"save-profile", "fields":["profile.name","profile.title","profile.avatar","profile.timezone","profile.locale"]},
    "skill-detail": {"primaryAction":"install-skill", "fields":["skill.name","skill.description","skill.source","skill.version","skill.status","skill.inputs[]","skill.outputs[]"]},
    "task-detail": {"primaryAction":"complete-task", "fields":["task.title","task.project","task.assignee","task.status","task.priority","task.dueAt","task.activity[]"]}
  }
}
