{
  "version": "2.0.0",
  "truthPolicy": "Only render fields returned by a connected source. Unknown values render as 未记录/未读取事实/未分配, never zero-filled.",
  "pages": {
    "ceo-home": {"route":"pages/ceo-home.html","primaryAction":"open-runtime","fields":["company.name","company.status","project.current.name","project.current.goal","reports.pending","runtime.facts"],"states":["loading","empty-company","empty-project","partial","error"]},
    "project-center": {"route":"pages/project-center.html","primaryAction":"create-project","fields":["projects[].name","projects[].department","projects[].status","projects[].progress","projects[].owner","projects[].updatedAt"],"states":["loading","empty","filter-empty","partial","error"]},
    "project-dept": {"route":"pages/project-dept.html?dept={department}","primaryAction":"create-project","fields":["department.name","department.projectCount","projects[].name","projects[].type","projects[].status","projects[].owner"],"states":["loading","empty","filter-empty","error"]},
    "org-center": {"route":"pages/org-center.html","primaryAction":"open-hr","fields":["organization.departmentCount","organization.employeeCount","departments[]","departments[].space","departments[].status","hr.systemDepartment"],"states":["loading","empty","partial","error"]},
    "org-employees": {"route":"pages/org-employees.html","primaryAction":"create-employee","fields":["employees[].name","employees[].role","employees[].department","employees[].project","employees[].status","employees[].capabilityCount"],"states":["loading","empty","filter-empty","error"]},
    "capability-center": {"route":"pages/capability-center.html","primaryAction":"create-capability","fields":["capabilities.agent.count","capabilities.model.count","capabilities.skill.count","capabilities.tool.count","capabilities.workflow.count","capabilities[].availability","capabilities[].source"],"states":["loading","empty","partial","error"]},
    "analytics": {"route":"pages/analytics.html","primaryAction":"change-period","fields":["period","metrics.projects","metrics.departments","metrics.workflows","metrics.completion","metrics.cost","breakdowns[]"],"states":["loading","empty","partial","error"]},
    "decision-center": {"route":"pages/decision-center.html","primaryAction":"open-decision","fields":["decisions.pending[]","decisions.pending[].priority","decisions.pending[].submitter","decisions.pending[].deadline","decisions.history[]","decision.context"],"states":["loading","empty","partial","error","success"]},
    "reports": {"route":"pages/reports.html","primaryAction":"open-report","fields":["reports.pending[]","reports.reviewed[]","reports.archived[]","report.context","report.reviewStatus"],"states":["loading","empty","filter-empty","error","success"]},
    "strategy-room": {"route":"pages/strategy-room.html","primaryAction":"create-meeting","fields":["meetings.active[]","meetings.archived[]","meeting.context","meeting.participants","meeting.status","meeting.timeline[]"],"states":["loading","empty","error","success"]},
    "brainstorm": {"route":"pages/brainstorm.html","primaryAction":"create-session","fields":["sessions.active[]","sessions.results[]","session.topic","session.participants","session.status"],"states":["loading","empty","error","success"]},
    "knowledge": {"route":"pages/knowledge.html","primaryAction":"open-scope","fields":["knowledge.company[]","knowledge.project[]","knowledge.department[]","knowledge.updatedAt","knowledge.source"],"states":["loading","empty","error"]},
    "execution": {"route":"pages/execution.html","primaryAction":"open-task-queue","fields":["tasks.queue[]","tasks.queue[].status","runs.recent[]","runs.recent[].result","runs.recent[].startedAt"],"states":["loading","empty","partial","error"]},
    "settings": {"route":"pages/settings.html","primaryAction":"save-settings","fields":["company.profile","company.brand","company.notificationPolicy"],"states":["loading","error","success"]},
    "company-runtime": {"route":"pages/company-runtime.html","primaryAction":"retry-facts","fields":["runtime.company","runtime.departments","runtime.employees","runtime.projects","runtime.workflows","runtime.readAt"],"states":["loading","partial","error"]},
    "project-miniapp-detail": {"route":"pages/project-miniapp-detail.html","primaryAction":"create-project-draft","fields":["project.name","project.goal","project.owner","project.tasks[]","project.resources.model","project.resources.skill","project.resources.tool"],"states":["default","create-dialog","resource-drawer","success","error"]},
    "project-xhs-workflow-detail": {"route":"pages/project-xhs-workflow-detail.html","primaryAction":"create-workflow-draft","fields":["workflow.name","workflow.goal","workflow.steps[]","workflow.reviewGate","workflow.resources.model","workflow.resources.skill","workflow.resources.tool"],"states":["default","create-dialog","resource-drawer","success","error"]},
    "department-create": {"route":"pages/department-create.html","primaryAction":"create-department-draft","fields":["department.name","department.goal","department.creationMode"],"states":["default","focus","validation-error","success"]},
    "employee-create": {"route":"pages/employee-create.html","primaryAction":"create-employee-draft","fields":["employee.name","employee.role","employee.initialDepartment","employee.businessDepartment","employee.project"],"states":["default","focus","validation-error","success"]}
  }
}
