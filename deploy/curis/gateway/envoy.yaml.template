static_resources:
  listeners:
    - name: curis_gateway
      address:
        socket_address: { address: 0.0.0.0, port_value: 8080 }
      filter_chains:
        - filters:
            - name: envoy.filters.network.http_connection_manager
              typed_config:
                "@type": type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager
                stat_prefix: curis_gateway
                generate_request_id: true
                access_log:
                  - name: envoy.access_loggers.stdout
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.access_loggers.stream.v3.StdoutAccessLog
                      log_format:
                        text_format_source:
                          inline_string: "%REQ(X-REQUEST-ID)% %REQ(:METHOD)% %REQ_WITHOUT_QUERY(:PATH)% %RESPONSE_CODE% %RESPONSE_FLAGS%\n"
                        formatters:
                          - name: envoy.formatter.req_without_query
                            typed_config:
                              "@type": type.googleapis.com/envoy.extensions.formatter.req_without_query.v3.ReqWithoutQuery
                route_config:
                  name: curis_routes
                  virtual_hosts:
                    - name: workspace
                      domains: ["*"]
                      request_headers_to_remove:
                        - x-forwarded-for
                        - x-forwarded-host
                        - x-forwarded-port
                        - x-forwarded-proto
                        - x-forwarded-user
                        - x-forwarded-email
                      routes:
                        - match: { prefix: "/api/auth/local/" }
                          typed_per_filter_config:
                            envoy.filters.http.jwt_authn:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.PerRouteConfig
                              disabled: true
                          route: { cluster: workspace, timeout: 60s }
                        - match: { prefix: "/api/auth/google/" }
                          typed_per_filter_config:
                            envoy.filters.http.jwt_authn:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.PerRouteConfig
                              disabled: true
                          route: { cluster: workspace, timeout: 60s }
                        - match:
                            prefix: "/api/pipeline/"
                            headers:
                              - { name: ":method", exact_match: "OPTIONS" }
                              - { name: "origin", exact_match: "http://127.0.0.1:3001" }
                              - name: "access-control-request-method"
                                safe_regex_match: { google_re2: {}, regex: "^(GET|POST)$" }
                              - { name: "access-control-request-headers", exact_match: "content-type" }
                          typed_per_filter_config:
                            envoy.filters.http.jwt_authn:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.PerRouteConfig
                              disabled: true
                          direct_response: { status: 204 }
                          response_headers_to_add:
                            - header: { key: "access-control-allow-origin", value: "http://127.0.0.1:3001" }
                            - header: { key: "access-control-allow-methods", value: "GET, POST" }
                            - header: { key: "access-control-allow-headers", value: "content-type" }
                            - header: { key: "access-control-allow-credentials", value: "true" }
                        - match:
                            prefix: "/api/workspace/projects/"
                            headers:
                              - { name: ":method", exact_match: "OPTIONS" }
                              - { name: "origin", exact_match: "http://127.0.0.1:3001" }
                              - { name: "access-control-request-method", exact_match: "PATCH" }
                              - { name: "access-control-request-headers", exact_match: "content-type" }
                          typed_per_filter_config:
                            envoy.filters.http.jwt_authn:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.PerRouteConfig
                              disabled: true
                          direct_response: { status: 204 }
                          response_headers_to_add:
                            - header: { key: "access-control-allow-origin", value: "http://127.0.0.1:3001" }
                            - header: { key: "access-control-allow-methods", value: "PATCH" }
                            - header: { key: "access-control-allow-headers", value: "content-type" }
                            - header: { key: "access-control-allow-credentials", value: "true" }
                        - match:
                            prefix: "/api/"
                            headers:
                              - name: cookie
                                safe_regex_match: { google_re2: {}, regex: ".*curis_local_session=.*" }
                          typed_per_filter_config:
                            envoy.filters.http.jwt_authn:
                              "@type": type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.PerRouteConfig
                              disabled: true
                          route: { cluster: workspace, timeout: 60s }
                        - match: { prefix: "/" }
                          route: { cluster: workspace, timeout: 60s }
                http_filters:
                  - name: envoy.filters.http.lua
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua
                      default_source_code:
                        inline_string: |
                          function envoy_on_request(handle)
                            local headers = handle:headers()
                            local remove = {}
                            for key, _ in pairs(headers) do
                              local lower = string.lower(key)
                              if string.match(lower, "^x%-curis%-gateway%-") or
                                 string.match(lower, "^x%-auth%-request%-") then
                                table.insert(remove, key)
                              end
                            end
                            for _, key in ipairs(remove) do headers:remove(key) end
                          end
                  - name: envoy.filters.http.jwt_authn
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.jwt_authn.v3.JwtAuthentication
                      providers:
                        oidc:
                          issuer: "{{OIDC_ISSUER}}"
                          audiences: ["{{OIDC_AUDIENCE}}"]
                          remote_jwks:
                            http_uri:
                              uri: "{{OIDC_JWKS_URI}}"
                              cluster: oidc_jwks
                              timeout: 5s
                            cache_duration: 300s
                            async_fetch: {}
                          forward: false
                          payload_in_metadata: verified_jwt
                          claim_to_headers:
                            - { header_name: x-curis-gateway-subject, claim_name: sub }
                            - { header_name: x-curis-gateway-issuer, claim_name: iss }
                            - { header_name: x-curis-gateway-auth-time, claim_name: auth_time }
                      rules:
                        - match: { path: "/health" }
                          requires: { allow_missing_or_failed: {} }
                        - match: { prefix: "/" }
                          requires: { provider_name: oidc }
                  - name: envoy.filters.http.lua
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.lua.v3.Lua
                      default_source_code:
                        inline_string: |
                          function envoy_on_request(handle)
                            local headers = handle:headers()
                            headers:remove("authorization")
                            headers:replace("x-curis-gateway-request-id", headers:get("x-request-id") or "")
                          end
                  - name: envoy.filters.http.router
                    typed_config:
                      "@type": type.googleapis.com/envoy.extensions.filters.http.router.v3.Router
  clusters:
    - name: workspace
      type: STATIC
      connect_timeout: 2s
      load_assignment:
        cluster_name: workspace
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address: { address: 172.30.0.3, port_value: 8002 }
    - name: oidc_jwks
      type: LOGICAL_DNS
      connect_timeout: 5s
      dns_lookup_family: V4_ONLY
      load_assignment:
        cluster_name: oidc_jwks
        endpoints:
          - lb_endpoints:
              - endpoint:
                  address:
                    socket_address: { address: "{{JWKS_HOST}}", port_value: {{JWKS_PORT}} }
{{JWKS_TLS}}
